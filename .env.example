# Copy to .env for local development. Never commit .env.

PORT=8080
NODE_ENV=development

# mock: accepts "Authorization: Bearer dev:<uid>" (local only, refused in production)
# firebase: verifies real Firebase ID tokens
AUTH_MODE=mock

# memory: in-process store, wiped on restart (local only)
# firestore: Cloud Firestore through firebase-admin
STORE_MODE=memory

# Service account JSON for firebase-admin, as one line (only for AUTH_MODE/STORE_MODE=firebase/firestore)
FIREBASE_CREDENTIALS=

# Hugging Face Inference token. Empty = on-device lexicon sentiment only.
HF_TOKEN=
HF_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
HF_TIMEOUT_MS=8000

# Day boundaries for streaks and daily tasks
APP_TIME_ZONE=Asia/Kolkata
DAILY_COIN_CAP=60

# Comma-separated, or * for any (mobile apps don't send Origin)
CORS_ORIGINS=*
